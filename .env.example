# QuantumCanvas — copy to .env (NEVER commit .env). On Azure, put these in the App Service
# "Environment variables" / "Configuration" -> "Application settings" instead.

# IonQ (only needed for IonQ backends)
IONQ_API_KEY=

# Explanation layer (optional). Provider-neutral, OpenAI-compatible. Leave blank => template-only explanations.
# Cloudflare Workers AI:
#   LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional second provider, used when the first is out of quota:
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Keep a free daily allowance from running out (0 = no limit). Resets 00:00 UTC.
LLM_DAILY_REQUEST_BUDGET=100

# Research interaction logging (Paper A): off unless "on" AND each event carries consent. Check IRB first.
RESEARCH_LOGGING=off

# Optional MongoDB Atlas mirror of run records
MONGODB_URI=

# ── Security (2026 review) ──────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API. Leaving this blank
# defaults to "*" (any website) — set it to your real frontend's origin before going public,
# e.g.: CORS_ORIGINS=https://your-frontend.azurestaticapps.net
CORS_ORIGINS=

# Real quantum hardware costs real money per job. Submitting to it is OFF unless you set
# this to "on" — the frontend's "confirm the cost" dialog is a UI nicety, not a security
# boundary, so this is the actual gate. Only turn it on once you also have some form of
# auth or per-user quota in front of the API.
ALLOW_QPU_SUBMIT=off

# Hard ceiling on circuit size / shots for /execute and /compile (defaults: 24 qubits,
# 100000 shots). Aer needs 2**qubits amplitudes in memory, so an uncapped request can
# exhaust the server for everyone else. Lower these if your instance has less RAM.
MAX_QUBITS=24
MAX_SHOTS=100000

# Simple in-memory per-IP rate limit (requests/minute) for /execute, /cost and /compile.
# Not shared across multiple instances — fine for a single App Service instance.
RATE_LIMIT_PER_MINUTE=30

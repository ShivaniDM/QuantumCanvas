# QuantumCanvas — copy to .env (NEVER commit .env). On Azure, put these in the App Service
# "Environment variables" / "Configuration" -> "Application settings" instead.

# IonQ (only needed for IonQ backends)
IONQ_API_KEY=

# Explanation layer (optional). Provider-neutral, OpenAI-compatible. Leave blank => template-only explanations.
# Cloudflare Workers AI:
#   LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional second provider, used when the first is out of quota:
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Keep a free daily allowance from running out (0 = no limit). Resets 00:00 UTC.
LLM_DAILY_REQUEST_BUDGET=100

# Research interaction logging (Paper A): off unless "on" AND each event carries consent. Check IRB first.
RESEARCH_LOGGING=off

# Optional MongoDB Atlas mirror of run records
MONGODB_URI=
